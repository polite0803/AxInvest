{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "plugins": [
    "node_modules/@dprint/typescript/plugin.wasm",
    "node_modules/@dprint/json/plugin.wasm",
    "node_modules/@dprint/markdown/plugin.wasm",
    "node_modules/@dprint/toml/plugin.wasm"
  ],
  "excludes": [
    ".trae/**/*",
    "node_modules/**/*",
    "dist/**/*",
    "target/**/*",
    "public/**/*",
    "output/**/*",
    "**/CHANGELOG.md",
    "src-tauri/schema-gen/**/*",
    "src-tauri/crates/**/bindings/**/*",
    "scripts/**/*",
    "src-tauri/scripts/**/*",
    "knowledge-sources/**/*"
  ],
  // 行尾必须与 .gitattributes 的 `* text=auto eol=lf` 一致。
  // 缺省值为 auto（跟随操作系统），Windows 上会产出 CRLF，与 .gitattributes 冲突，
  // 导致 `dprint check` 周期性报 "Text differed by line endings"。显式锁死为 lf。
  // 完整防线见 .editorconfig 顶部注释（编辑器和 git 各管一段，不能只靠这里）。
  "newLineKind": "lf",
  "typescript": {
    "quoteStyle": "preferDouble",
    "useBraces": "always"
  },
  "json": {},
  "markdown": {
    "lineWidth": 120
  },
  "toml": {}
}
