{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "plugins": [
    "node_modules/@dprint/typescript/plugin.wasm",
    "node_modules/@dprint/json/plugin.wasm",
    "node_modules/@dprint/markdown/plugin.wasm",
    "node_modules/@dprint/toml/plugin.wasm"
  ],
  "excludes": [
    ".trae/**/*",
    ".qoder/**/*",
    ".worktrees/**/*",
    "node_modules/**/*",
    "dist/**/*",
    "target/**/*",
    "public/**/*",
    "output/**/*",
    "docs/**/*",
    "**/CHANGELOG.md",
    "axagent-plugins/crates/schema-gen/**/*",
    "**/crates/*/bindings/**/*",
    "src/types/generated/**/*",
    "scripts/**/*",
    "src-tauri/scripts/**/*",
    "knowledge-sources/**/*"
  ],
  // ⚠ `docs/**/*` 必须排除（2026-11-01 补）：`docs/` 此前被 `.gitignore` 整目录忽略 ⇒ 176 份文档从未入库，
  // 也从未受 dprint 管辖；解除忽略后 CI 的 `dprint check`（ci.yml:430）立刻报 167 个文件未格式化。
  // 不能靠「跑一次 dprint fmt」消解：`docs/plans/PLAN-shell-plus-plugins.md` 的行号被
  // `scripts/capability-register.json` 逐行钉住，格式化会整体重排表格 ⇒ 镜像表锚点成批腐烂。
  // 故 docs/ 一律不参与格式化检查；新增文档同样不受管辖。
  // 行尾必须与 .gitattributes 的 `* text=auto eol=lf` 一致。
  // 缺省值为 auto（跟随操作系统），Windows 上会产出 CRLF，与 .gitattributes 冲突，
  // 导致 `dprint check` 周期性报 "Text differed by line endings"。显式锁死为 lf。
  // 完整防线见 .editorconfig 顶部注释（编辑器和 git 各管一段，不能只靠这里）。
  "newLineKind": "lf",
  "typescript": {
    "quoteStyle": "preferDouble",
    "useBraces": "always"
  },
  "json": {},
  "markdown": {
    "lineWidth": 120
  },
  "toml": {}
}
