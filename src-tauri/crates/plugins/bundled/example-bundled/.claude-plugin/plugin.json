{
  "name": "example-bundled",
  "version": "0.2.0",
  "description": "Example bundled plugin scaffold for the Rust plugin system",
  "defaultEnabled": false,
  "hooks": {
    "PreToolUse": [
      "./hooks/pre.sh"
    ],
    "PostToolUse": [
      "./hooks/post.sh"
    ]
  },
  "dashboard_panels": [
    {
      "id": "hello-panel",
      "title": "示例插件面板",
      "componentName": "example-bundled.hello",
      "position": "main",
      "size": "medium",
      "props": {
        "caption": "沙箱 iframe 渲染"
      },
      "frontendEntry": "ui/panel.html"
    },
    {
      "id": "title-only",
      "title": "仅标题的面板",
      "componentName": "example-bundled.title-only"
    }
  ]
}
